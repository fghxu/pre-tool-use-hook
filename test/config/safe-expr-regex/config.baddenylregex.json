{
  "version": "1.0",
  "description": "BAD-DENY-REGEX FIXTURE for the static denylist (2026-09-19). Load-Config MUST throw: 'Invalid regex in safe_expressions.dotnet_static_method_denylist_regex'.",

  "global_modifying_strictness": "normal",

  "trusted_pattern": [],
  "untrusted_pattern": [],

  "intercept_tool_name": [ "Bash" ],
  "tool_name_mapping": { "Bash": "tool_input.command" },
  "ignore_tool_name": [],

  "safe_expressions": {
    "dotnet_static_method_denylist_regex": [
      "^("
    ]
  },

  "commands": {
    "PowerShell": {
      "modifying_strictness": "normal",
      "read_only_verbs": ["Get-*"],
      "modifying_verbs": {
        "high":   ["Remove-*"],
        "medium": [],
        "low":    []
      },
      "read_only": [],
      "modifying": []
    }
  }
}
