<?xml version="1.0" encoding="UTF-8"?>
<!-- SAFETYNET SUITE - the safetynet feature (LLM second-opinion for unknown
     local tiers when normal scope gate says out-of-scope).
     KEY INVARIANT: safetynet NEVER changes the decision. Local ask stays ask.
     The LLM verdict is consulted ONLY to enrich the reason text the human sees
     at approval time, so the human can reason faster.
     Mock values idx:... inject attributed JSON verdicts. The safetynet attribute
     on each case toggles safetynet.enabled on the compiled block.
     Run:  pwsh -NoProfile -File test/config/llm-review/Run-Tests.ps1 -XmlPath test/config/llm-review/test-cases.safetynet.xml -->
<commands>
  <category-group name="Safetynet">

    <!-- =========================================================== -->
    <!-- CORE: safetynet fires when local tier is unknown AND normal -->
    <!-- scope gate says out-of-scope. Final is ALWAYS ask (never     -->
    <!-- downgrade). Reason must carry the local tier + LLM verdict. -->
    <!-- =========================================================== -->

    <!-- Single unknown sub-command: out-of-scope normally (1 < min=2), but
         safetynet fires because tier=unclassified. LLM says read-only.
         Final = ask (safetynet never downgrades). Reason must show the
         LLM's READ-ONLY verdict for human reference. -->
    <test-case expected="ask" category="SN-UnclassifiedFireReadOnly" level="complex_commands" safetynet="true" mock="idx:" in-scope="true" verdict="read-only" effect="safetynet-ask" reason-contains="safetynet: local unclassified;LLM second-opinion: READ-ONLY" reason="single unclassified command, out-of-scope normally, safetynet fires, LLM says read-only => final ask, reason shows LLM hint">
      <description>frobnicate --foo — unclassified, single sub-command, safetynet fires</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[frobnicate --foo]]></copilot-command>
    </test-case>

    <!-- Single unknown sub-command: safetynet fires, LLM says modifying. -->
    <test-case expected="ask" category="SN-UnclassifiedFireModifying" level="complex_commands" safetynet="true" mock="idx:1" in-scope="true" verdict="modifying" effect="safetynet-ask" reason-contains="safetynet: local unclassified;LLM second-opinion: MODIFYING" reason="unclassified + LLM modifying => final ask, reason shows LLM hint">
      <description>frobnicate --write — unclassified, safetynet fires, LLM says modifying</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[frobnicate --write]]></copilot-command>
    </test-case>

    <!-- =========================================================== -->
    <!-- DISABLED: safetynet off => no LLM call. Same as today.       -->
    <!-- =========================================================== -->

    <!-- safetynet=false: out-of-scope, no LLM call. Not in scope, no verdict. -->
    <test-case expected="ask" category="SN-DisabledNoCall" level="complex_commands" safetynet="false" mock="idx:" in-scope="false" verdict="not_called" effect="none" reason="safetynet off => out-of-scope gate stays; no LLM call">
      <description>frobnicate --foo — safetynet disabled, single sub-command, out of scope</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[frobnicate --foo]]></copilot-command>
    </test-case>

    <!-- master kill switch: llm_second_opinion.enabled=false. No LLM call at
         all (no feature, no safetynet). Decision still ask (local unclassified). -->
    <test-case expected="ask" category="SN-FeatureDisabledNoCall" level="complex_commands" enabled="false" safetynet="true" mock="idx:" in-scope="false" verdict="not_called" effect="none" reason="master enabled=false => no feature at all, no safetynet">
      <description>frobnicate --foo — feature disabled, no LLM call regardless of safetynet</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[frobnicate --foo]]></copilot-command>
    </test-case>

    <!-- =========================================================== -->
    <!-- FAILURE MODES: LLM down/unusable. Final = ask, reason notes  -->
    <!-- safetynet was attempted but LLM unavailable.                 -->
    <!-- =========================================================== -->

    <test-case expected="ask" category="SN-UnclassifiedLLMDown" level="complex_commands" safetynet="true" mock="down" in-scope="true" verdict="down" effect="forced-ask" reason-contains="safetynet: local unclassified;LLM-DOWN" reason="safetynet fires, LLM unreachable => forced ask">
      <description>frobnicate --foo — safetynet fires, LLM down => forced ask</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[frobnicate --foo]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="SN-UnclassifiedLLMUnusable" level="complex_commands" safetynet="true" mock="garbage" in-scope="true" verdict="unusable" effect="forced-ask" reason-contains="safetynet: local unclassified;LLM-UNUSABLE" reason="safetynet fires, LLM garbage => forced ask">
      <description>frobnicate --foo — safetynet fires, LLM unusable => forced ask</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[frobnicate --foo]]></copilot-command>
    </test-case>

    <!-- =========================================================== -->
    <!-- KNOWN TIER: not an unknown tier, so safetynet does NOT fire. -->
    <!-- This is the key guardrail: safetynet only helps with         -->
    <!-- "couldn't identify" cases, not with normal ask decisions.    -->
    <!-- =========================================================== -->

    <!-- Two known commands (rm + ls): local ask (rm is high). Even with
         safetynet on, it's IN normal scope (2 sub-commands) so the scope
         gate fires normally and safetynet is not consulted. -->
    <test-case expected="ask" category="SN-KnownTierInNormalScope" level="complex_commands" safetynet="true" mock="idx:1" in-scope="true" verdict="modifying" effect="agree" reason="known rm + ls in normal scope => normal path, safetynet not triggered (scope was true)">
      <description>rm file ; ls dir — known modifying + read-only, in normal scope, safetynet not consulted</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[rm c:\temp\foo.txt ; ls c:\temp]]></copilot-command>
    </test-case>

  </category-group>
</commands>
