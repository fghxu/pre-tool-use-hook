{
  "version": "1.0",
  "description": "TEST FIXTURE variant: editable_paths enabled + Linux domain EXPLICIT normal_override_llm + curl ENTRY flipped to normal. D5 precedence: the entry value is consulted BEFORE the domain value, so the entry alone loses the override and falls back to the legacy guard (which denies the foreign -o target).",
  "_comment_fixture": "Used by T31.",

  "global_modifying_strictness": "normal_override_llm",

  "editable_paths": { "windows": ["C:\\\\tmp\\\\ov-edit\\\\.*"] },

  "log_file_path": "c:\\temp\\pretoolhook-ov-testlogs\\",

  "trusted_pattern": [],
  "untrusted_pattern": [],

  "trusted_programs": [
    "src\\Run-AllTests.ps1"
  ],

  "system_paths": {
    "linux": ["/etc", "/usr", "/bin", "/sbin"],
    "windows": ["C:\\\\Windows", "C:\\\\Program Files"]
  },

  "intercept_tool_name": [ "Bash", "run_in_terminal" ],

  "tool_name_mapping": {
    "Bash": "tool_input.command",
    "run_in_terminal": "tool_input.command"
  },

  "ignore_tool_name": [],

  "llm_second_opinion": {
    "enabled": true,
    "level": "complex_commands",
    "base_uri": "http://127.0.0.1:3030",
    "model": "glm-5.2",
    "api_key": "",
    "timeout_ms": 12000,
    "temperature": 0.0,
    "llm_response_max_tokens": 64,
    "complex_min_subcommands": 2,
    "attributed_verdicts": true,
    "json_mode": false,
    "check_blindspot": {
      "enabled": false,
      "tiers": ["unclassified", "unregistered_verb", "unregistered_static", "unregistered", "unknown_domain"]
    }
  },

  "commands": {
    "Linux": {
      "modifying_strictness": "normal_override_llm",
      "description": "Domain ON, but the curl ENTRY below is normal and WINS for curl (entry > domain).",
      "read_only": [
        { "name": "git-status",   "patterns": ["git status*"] },
        { "name": "git-diff",     "patterns": ["git diff*"] },
        { "name": "terraform-validate", "patterns": ["terraform validate*"] },
        { "name": "kubectl-get",  "patterns": ["kubectl get*"] }
      ],
      "strictness_gated": [
        { "name": "git-add",         "patterns": ["git add*"],        "risk": "low" },
        { "name": "terraform-plan",  "patterns": ["terraform plan*"], "risk": "low" },
        { "name": "kubectl-config",  "patterns": ["kubectl config *"], "risk": "low" }
      ],
      "modifying": [
        { "name": "rm-rf", "patterns": ["rm *"], "risk": "high" }
      ],
      "parameter_commands": {
        "curl": {
          "rules": [
            { "param": ["-X"], "match": "present", "decision": "modifying", "risk": "medium" },
            { "param": ["-o"], "match": "present", "decision": "strictness_gated" }
          ],
          "default": "read-only",
          "modifying_strictness": "normal"
        }
      }
    },
    "Terraform": {
      "description": "Terraform domain (parser routes 'terraform' here via KnownBinaryPrefixes). NO modifying_strictness -> inherits global.",
      "read_only": [
        { "name": "terraform-validate", "patterns": ["terraform validate*"] }
      ],
      "strictness_gated": [
        { "name": "terraform-plan", "patterns": ["terraform plan*"], "risk": "low" }
      ]
    },
    "Kubernetes": {
      "description": "Kubernetes domain (parser routes 'kubectl' here via KnownBinaryPrefixes). NO modifying_strictness -> inherits global.",
      "read_only": [
        { "name": "kubectl-get", "patterns": ["kubectl get*"] }
      ],
      "strictness_gated": [
        { "name": "kubectl-config", "patterns": ["kubectl config *"], "risk": "low" }
      ]
    },
    "PowerShell": {
      "modifying_strictness": "normal",
      "description": "Opted out, as base.",
      "read_only_verbs": ["Get-*", "Test-*", "Select-*", "Where-*", "Sort-*", "Measure-*"],
      "read_only": [
        { "name": "get-date", "patterns": ["Get-Date"] }
      ],
      "strictness_gated": [
        { "name": "ps-setcontent", "patterns": ["Set-Content*"], "risk": "low" },
        { "name": "ps-copy-item",  "patterns": ["Copy-Item*"],  "risk": "low" },
        { "name": "ps-new-item",   "patterns": ["New-Item*"],   "risk": "low" }
      ],
      "modifying": [
        { "name": "ps-remove-item", "patterns": ["Remove-Item*"], "risk": "high" }
      ]
    }
  }
}
