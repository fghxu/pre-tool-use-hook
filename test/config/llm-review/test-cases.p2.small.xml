<?xml version="1.0" encoding="UTF-8"?>
<!-- PHASE-II SMALL SUITE - the 10 typical attributed-verdict cases.
     DEFAULT file for Run-Tests.ps1. Mock values idx:... inject attributed JSON
     verdicts through the REAL parser; strictness="normal" makes the gated tier
     allow (the fixture file's global default is strict).
     Run:  pwsh -NoProfile -File test/config/llm-review/Run-Tests.ps1 -->
<commands>
  <category-group name="P2Small">

    <test-case expected="allow" category="P2-GatedBothSuppressed" level="complex_commands" strictness="normal" mock="idx:1,2" in-scope="true" verdict="modifying" effect="veto-suppressed-policy" flagged="1,2" suppressed="1,2" reason="both gated commands flagged; all suppressed by policy => allow">
      <description>suppression: git add + git commit flagged, all suppressed</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m x]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-MixedVetoOnReadOnly" level="complex_commands" strictness="normal" mock="idx:1,2" in-scope="true" verdict="modifying" effect="veto" flagged="1,2" suppressed="1" reason-contains="curl -o;suppressed as policy" reason="gated flag suppressed, read_only flag vetoes => ask naming the offender">
      <description>mixed: veto stands only on the read_only sub-command</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; curl -o c:\temp\x http://h/y]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-ReadOnlyFlagVeto" level="complex_commands" strictness="normal" mock="idx:1" in-scope="true" verdict="modifying" effect="veto" flagged="1" suppressed="" reason-contains="git status" reason="read_only tier flagged (git status) => veto, not suppressible">
      <description>read_only tier flag => veto</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git status && git add .]]></copilot-command>
    </test-case>

    <test-case expected="allow" category="P2-EmptyIdxAgree" level="complex_commands" mock="idx:" in-scope="true" verdict="read-only" effect="agree" reason="empty modifying array = all read-only => agree allow">
      <description>idx: (empty) => agree</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[Get-Date ; Get-ChildItem c:\temp]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-BareTrueFallback" level="complex_commands" strictness="normal" mock="modifying" in-scope="true" verdict="modifying" effect="veto" flagged="" suppressed="" reason="bare 'true' is unattributed (P5) => full veto even on a gated block">
      <description>bare-token fallback: unattributed true => full veto</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m x]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-IdxZeroVeto" level="complex_commands" strictness="normal" mock="idx:0" in-scope="true" verdict="modifying" effect="veto" flagged="0" suppressed="" reason="index 0 = unlisted danger (P3) => veto, never suppressible">
      <description>idx:0 => veto</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m x]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-InvalidIdxUnusable" level="complex_commands" strictness="normal" mock="idx:5" in-scope="true" verdict="unusable" effect="forced-ask" reason-contains="*** LLM-UNUSABLE ***" reason="index 5 out of range for 2 sub-commands => unusable => fail-closed ask">
      <description>out-of-range index => unusable</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m x]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-LocalAskAgree" level="complex_commands" strictness="normal" mock="idx:1,2" in-scope="true" verdict="modifying" effect="agree" reason="local already asks (git push is modifying tier) => LLM modifying agrees; LLM never downgrades">
      <description>local ask + attributed modifying => agree</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git push origin main ; git add .]]></copilot-command>
    </test-case>

    <test-case expected="ask" category="P2-AttributedOffVeto" level="complex_commands" strictness="normal" attributed="false" mock="modifying" in-scope="true" verdict="modifying" effect="veto" reason="attributed_verdicts=false restores the phase-I binary path: gated block vetoes as in phase I">
      <description>attributed=false => phase-I veto</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m x]]></copilot-command>
    </test-case>

    <test-case expected="allow" category="P2-SingleGatedOutOfScope" level="complex_commands" strictness="normal" mock="idx:1" in-scope="false" verdict="not_called" effect="none" reason="single sub-command below min=2 => not checked (scope rules unchanged)">
      <description>single gated command at complex_commands => out of scope</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add .]]></copilot-command>
    </test-case>

    <!-- Option A: collapse 'pwsh -NoProfile -File <script>' into ONE sub-command (the script path) so a standalone trusted-script run drops below the LLM scope threshold (min 2) and the local trusted_program allow stands. Pre-fix it decomposed into 2 (path + wrapper) => in-scope => LLM veto => ask (RED). -->
    <test-case expected="allow" category="P2-PwshFileTrustedSingleSub" level="complex_commands" mock="idx:1" in-scope="false" verdict="not_called" effect="none" reason="Option A: pwsh -NoProfile -File trusted-script collapses to 1 sub-command (the script path) => below min=2 => out of scope; local trusted_program allow stands. Pre-fix = 2 sub-commands (path + wrapper) => in-scope => LLM veto => ask (RED).">
      <description>pwsh -File trusted script: single sub-command, out of LLM scope, local allow</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[pwsh -NoProfile -File "c:\git\cc\pretoolhook\src\Run-AllTests.ps1"]]></copilot-command>
    </test-case>

    <!-- Guard: an UNTRUSTED script must still fail closed to ask. Passes pre AND post Option A (no scope/verdict asserted so it holds both ways); mock set only to avoid a real HTTP attempt when in-scope pre-fix. -->
    <test-case expected="ask" category="P2-PwshFileUntrustedGuard" level="complex_commands" mock="idx:1" reason="guard: pwsh -File UNTRUSTED script stays fail-closed ask (bare path unclassified); passes pre AND post Option A">
      <description>pwsh -File untrusted script: still asks (fail-closed preserved)</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[pwsh -NoProfile -File "c:\temp\not-trusted-xyz.ps1"]]></copilot-command>
    </test-case>

    <!-- Option B: a trusted_program sub-command gets the SAME suppression power as strictness_gated in the LLM merge. Sub 1 = the fixture's trusted script (src\Run-AllTests.ps1), sub 2 = git status (read_only). The LLM flags ONLY the trusted one (idx:1); post-fix it is suppressed by policy => local allow stands. Pre-fix trusted_program was NOT suppressible => veto => ask (RED). -->
    <test-case expected="allow" category="P2-TrustedProgramSuppressed" level="complex_commands" mock="idx:1" in-scope="true" verdict="modifying" effect="veto-suppressed-policy" flagged="1" suppressed="1" reason="Option B: LLM flags the trusted_program sub-command (idx 1); it is now suppressible like strictness_gated => all flags suppressed => local allow stands. Pre-fix trusted_program vetoed => ask (RED).">
      <description>trusted_program flag suppressed by policy (mirrors strictness_gated)</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[pwsh -NoProfile -File "c:\git\cc\pretoolhook\src\Run-AllTests.ps1" ; git status]]></copilot-command>
    </test-case>

    <!-- Option B guard: suppression is per-tier. The LLM flags the read_only sub-command (idx 2 = git status), NOT the trusted one. read_only has no suppression power => veto stands => ask. Passes pre AND post Option B (pins that trusted_program power does not leak to other tiers). -->
    <test-case expected="ask" category="P2-TrustedProgramReadOnlyStillVetoes" level="complex_commands" mock="idx:2" in-scope="true" verdict="modifying" effect="veto" flagged="2" suppressed="" reason-contains="git status" reason="Option B guard: LLM flags the read_only sub-command (git status, idx 2); read_only is never suppressible => veto => ask. Confirms trusted_program power does not extend to other tiers.">
      <description>read_only flag still vetoes even when a sibling is trusted</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[pwsh -NoProfile -File "c:\git\cc\pretoolhook\src\Run-AllTests.ps1" ; git status]]></copilot-command>
    </test-case>

    <!-- Option B end-to-end (fullpipe): through the REAL hook process, a trusted_program flag is suppressed and the reconciliation log carries the tier-accurate label 'all suppressed (trusted_program policy)'. curl keeps the block in scope at the fixture's own complex_remote level. Pre-fix: trusted vetoed => ask + wrong label (RED). -->
    <test-case expected="allow" category="P2-TrustedProgramFullPipeSuppressed" mode="fullpipe" mock="idx:1" log-contains="LLM-RECONCILE;all suppressed (trusted_program policy)" reason="Option B fullpipe: trusted flag suppressed end-to-end + the child hook's .log reconcile line names the trusted_program tier (not strictness_gated).">
      <description>fullpipe: trusted suppression + tier-accurate reconciliation label</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[pwsh -NoProfile -File "c:\git\cc\pretoolhook\src\Run-AllTests.ps1" ; curl http://h/y]]></copilot-command>
    </test-case>

    <!-- Compound wrapper (2026-09-17 production incident): the pwsh -File wrapper is NOT the first segment (a read-only command precedes it). Pre-fix, Find-NestedCommands was anchored (^pwsh) and called on the FULL string, so it never matched — the whole 'pwsh -NoProfile -File <script>' segment fell to the generic pwsh read_only pattern. The script path lost its trusted_program tier, so when the LLM flagged it (idx 2), Option B could NOT suppress it => veto => ask. Post-fix, per-segment unwrapping grants the script path tier=trusted_program; the LLM flag on idx 2 is suppressed by policy => local allow stands. curl keeps the block in scope at complex_remote. (ls /tmp is the first segment because the fixture's minimal config recognizes ls but not cd.) -->
    <test-case expected="allow" category="P2-TrustedProgramCompoundSuppressed" level="complex_commands" mock="idx:3" in-scope="true" verdict="modifying" effect="veto-suppressed-policy" flagged="3" suppressed="3" reason="Compound ls; pwsh -File: per-segment unwrap grants trusted_program tier to the script path (idx 3 — nested/unwrapped commands are appended after the regex-split segments); LLM flag on idx 3 is suppressed by Option B policy => local allow stands. Pre-fix: wrapper not first segment => no unwrap => read_only tier => veto => ask (RED).">
      <description>compound ls; pwsh -File trusted script: LLM flags the script (idx 3), suppressed by trusted_program policy</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[ls /tmp; pwsh -NoProfile -File src/Run-AllTests.ps1; curl http://h/y]]></copilot-command>
    </test-case>

    <!-- strict_gate_override_llm switch (2026-09-16 spec). Sub 2 = git commit carrying a SYSTEM-PATH token, so the stage-2 path guard DENIES suppression. Switch false/absent => veto stands => ask (guard case: passes pre AND post; pins that the default does not loosen today's reconciliation). The safe-path + switch-false => suppressed behavior is already pinned by P2-GatedBothSuppressed above. -->
    <test-case expected="ask" category="P2-GateOverride-DefaultDenies" level="complex_commands" strictness="normal" mock="idx:2" in-scope="true" verdict="modifying" effect="veto" flagged="2" suppressed="" reason="switch absent (default false): gated flag + path-guard DENIAL (system-path token) => veto stands => ask. Pins default = today's reconciliation, not unconditional suppression.">
      <description>switch off: path-guard denial still vetoes a gated flag</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m "x" C:\Windows\a.txt]]></copilot-command>
    </test-case>

    <!-- strict_gate_override_llm=true: the local (config-declared) gated decision OVERPOWERS the online LLM, exactly like trusted_program — path guard bypassed. RED pre-fix (attribute not yet read by runner/merge => guard denies => ask); GREEN post-fix. -->
    <test-case expected="allow" category="P2-GateOverride-SwitchTrueSuppresses" level="complex_commands" strictness="normal" strict_gate_override="true" mock="idx:2" in-scope="true" verdict="modifying" effect="veto-suppressed-policy" flagged="2" suppressed="2" reason="switch true: gated flag unconditionally suppressed (trusted_program-style) even though the path guard would deny (system-path token) => local allow stands. RED pre-fix.">
      <description>switch on: local gated decision overpowers online LLM despite guard denial</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[git add . ; git commit -m "x" C:\Windows\a.txt]]></copilot-command>
    </test-case>

  </category-group>
</commands>
