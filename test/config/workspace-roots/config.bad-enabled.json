{
  "version": "1.0",
  "description": "TEST FIXTURE (schema negative) for workspace_roots: 'enabled' must be a boolean. The string 'yes' must throw - truthiness guessing on a security switch is exactly the kind of fail-open this project forbids.",

  "global_modifying_strictness": "normal",
  "ask_notification": { "enabled": false },

  "workspace_roots": {
    "enabled": "yes",
    "paths": [ "d:\\\\other-repo" ]
  },

  "trusted_pattern": [],
  "untrusted_pattern": [],

  "intercept_tool_name": [ "Bash" ],
  "tool_name_mapping": { "Bash": "tool_input.command" },
  "ignore_tool_name": [],

  "commands": {
    "Linux": {
      "modifying_strictness": "normal",
      "read_only": [ { "name": "ls", "patterns": [ "ls *" ], "description": "List directory contents" } ],
      "modifying": [ { "name": "rm", "patterns": [ "rm *" ], "risk": "high", "description": "Remove files/directories" } ]
    }
  }
}
