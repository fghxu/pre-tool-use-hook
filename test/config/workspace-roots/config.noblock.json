{
  "version": "1.0",
  "description": "TEST FIXTURE (negative control) for workspace_roots. No workspace_roots key at all: the loader must still initialize the internal root lists to empty and the path policy must behave EXACTLY as before this feature existed (d:\\other-repo asks).",

  "global_modifying_strictness": "normal",
  "log_file_path": "c:\\temp\\pretoolhook-workspace-roots-testlogs\\",
  "ask_notification": { "enabled": false },

  "trusted_pattern": [],
  "untrusted_pattern": [],

  "intercept_tool_name": [ "Bash", "Write" ],
  "tool_name_mapping": { "Bash": "tool_input.command" },
  "path_tool_mapping": { "Write": "tool_input.file_path" },
  "ignore_tool_name": [],

  "editable_paths": {
    "linux": [ "/tmp/" ],
    "windows": [ "C:\\\\temp\\\\" ]
  },

  "commands": {
    "Linux": {
      "modifying_strictness": "normal",
      "read_only": [ { "name": "ls", "patterns": [ "ls *" ], "description": "List directory contents" } ],
      "modifying": [ { "name": "rm", "patterns": [ "rm *" ], "risk": "high", "description": "Remove files/directories" } ]
    }
  }
}
