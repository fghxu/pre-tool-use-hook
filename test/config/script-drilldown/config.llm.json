{
  "version": "1.0",
  "description": "TEST FIXTURE for script_drilldown LLM sub-suite (2026-09-20). Drilldown ON + minimal llm_second_opinion block. Verdicts are injected via PRETOOLHOOK_LLMREVIEW_MOCK - no network, zero quota. Run by test/config/llm-review/Run-Tests.ps1 with -ConfigPath/-Cwd.",

  "global_modifying_strictness": "normal",

  "_comment_log_file_path": "Keep test records out of the real ~/.pretoolhook logs (house style).",
  "log_file_path": "c:\\temp\\pretoolhook-script-drilldown-testlogs\\",

  "trusted_pattern": [],
  "untrusted_pattern": [],

  "intercept_tool_name": [ "Bash" ],
  "tool_name_mapping": { "Bash": "tool_input.command" },
  "ignore_tool_name": [],

  "_comment_trusted_programs": "Basename form - trusted.ps1 is the D9 short-circuit target.",
  "trusted_programs": [
    "trusted.ps1"
  ],

  "script_drilldown": {
    "enabled": true,
    "runners": ["powershell"],
    "max_chained_files": 3,
    "max_file_bytes": 4096,
    "_comment_llm_scope": "count (default): script-origin statements count toward complex_min_subcommands AND appear in the numbered list sent to the LLM.",
    "llm_scope": "count"
  },

  "llm_second_opinion": {
    "enabled": true,
    "level": "complex_commands",
    "base_uri": "http://127.0.0.1:3030",
    "model": "glm-5.2",
    "api_key": "",
    "timeout_ms": 12000,
    "temperature": 0.0,
    "llm_response_max_tokens": 16,
    "complex_min_subcommands": 2,
    "attributed_verdicts": true,
    "json_mode": false,
    "_comment": "Verdicts mocked via PRETOOLHOOK_LLMREVIEW_MOCK; no network call ever happens.",
    "check_blindspot": {
      "enabled": false,
      "tiers": ["unclassified", "unregistered_verb", "unregistered_static", "unregistered", "unknown_domain"]
    }
  },

  "commands": {
    "PowerShell": {
      "modifying_strictness": "normal",
      "read_only_verbs": ["Get-*", "Test-*", "Select-*", "Where-*", "Sort-*", "Measure-*", "Format-*", "Out-GridView", "Write-Host", "Write-Output"],
      "modifying_verbs": {
        "high":   ["Remove-*", "Stop-*", "Disable-*", "Clear-*", "Reset-*"],
        "medium": ["Set-*", "New-*", "Copy-*", "Move-*", "Rename-*", "Start-*", "Send-*", "Push-*"],
        "low":    []
      },
      "read_only": [
        { "name": "pwsh", "patterns": ["pwsh(?:\\.exe)? *", "powershell(?:\\.exe)? *"], "description": "PowerShell wrapper (inner commands classified separately)" }
      ],
      "modifying": []
    },

    "Linux": {
      "modifying_strictness": "normal",
      "read_only": [
        { "name": "ls", "patterns": ["ls *"], "description": "List directory contents" },
        { "name": "cat", "patterns": ["cat *"], "description": "Print file contents" }
      ],
      "modifying": [
        { "name": "rm", "patterns": ["rm *"], "risk": "high", "description": "Remove files/directories" }
      ]
    }
  }
}
