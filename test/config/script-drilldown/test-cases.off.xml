    <test-case expected="ask" reason="OFF: untrusted -File path is unknown today" category="SDO-Allow-ReadOnly" reason-contains="unknown command: scripts\readonly.ps1">
      <description>pwsh -NoProfile -File scripts\readonly.ps1 - OFF parity (today: ask)</description>
      <tool-name>Bash</tool-name>
      <copilot-command><![CDATA[pwsh -NoProfile -File scripts\readonly.ps1]]></copilot-command>
    </test-case>

