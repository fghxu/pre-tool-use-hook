{
  "version": "1.0",
  "description": "TEST FIXTURE variant: V1 bare-token pair mode. llm_second_opinion.attributed_verdicts=false (V1 prompt, no indices). NOTE llm_third_opinion.attributed_verdicts stays TRUE on purpose - it is an IGNORED key; if the implementation wrongly read LLM2's copy the V1 pair cases (LT3-15/16) would flip and catch it.",
  "_comment_fixture": "Delta vs config.pair.json: llm_second_opinion.attributed_verdicts true -> false. Everything else identical.",

  "global_modifying_strictness": "normal",
  "log_file_path": "c:\\temp\\pretoolhook-llm-third-opinion-testlogs\\",
  "trusted_pattern": [],
  "untrusted_pattern": [],
  "trusted_programs": [ "tool-a.exe", "tool-b.exe", "src\\Classifier.ps1" ],
  "system_paths": { "linux": ["/etc", "/usr", "/bin", "/sbin"], "windows": ["C:\\\\Windows", "C:\\\\Program Files"] },
  "intercept_tool_name": [ "Bash", "run_in_terminal" ],
  "tool_name_mapping": { "Bash": "tool_input.command", "run_in_terminal": "tool_input.command" },
  "ignore_tool_name": [],

  "llm_second_opinion": {
    "enabled": true,
    "level": "complex_commands",
    "base_uri": "http://127.0.0.1:9",
    "model": "m1",
    "api_key": "",
    "timeout_ms": 30000,
    "temperature": 0.0,
    "llm_response_max_tokens": 256,
    "complex_min_subcommands": 2,
    "attributed_verdicts": false,
    "json_mode": false,
    "check_blindspot": { "enabled": false, "tiers": ["unclassified", "unregistered_verb", "unregistered_static", "unregistered", "unknown_domain"] }
  },

  "llm_third_opinion": {
    "enabled": true,
    "level": "complex_commands",
    "base_uri": "http://127.0.0.1:9",
    "model": "m2",
    "api_key": "",
    "timeout_ms": 60000,
    "temperature": 0.0,
    "llm_response_max_tokens": 256,
    "complex_min_subcommands": 2,
    "attributed_verdicts": true,
    "json_mode": true,
    "_comment_ignored": "Ignored key DELIBERATELY left true while LLM1 runs V1 - pins D2 (LLM1's sampling governs both).",
    "check_blindspot": { "enabled": true, "tiers": ["unclassified", "unregistered_verb", "unregistered_static", "unregistered", "unknown_domain"] }
  },

  "commands": {
    "PowerShell": {
      "modifying_strictness": "normal",
      "description": "Minimal PowerShell domain.",
      "read_only_verbs": ["Get-*", "Test-*", "Select-*", "Where-*", "Sort-*", "Measure-*", "Format-*", "Write-Host", "Write-Output"],
      "modifying_verbs": { "high": ["Remove-*", "Stop-*"], "medium": ["Set-*", "New-*", "Copy-*", "Move-*", "Rename-*"], "low": [] },
      "read_only": [], "modifying": [],
      "strictness_gated": [ { "name": "Set-Content", "patterns": ["Set-Content *"], "description": "Write file (gated)" } ]
    },
    "Linux": {
      "modifying_strictness": "normal",
      "description": "Minimal Linux domain.",
      "read_only": [ { "name": "ls", "patterns": ["ls *"], "description": "List" }, { "name": "cat", "patterns": ["cat *"], "description": "Print" } ],
      "modifying": [ { "name": "rm", "patterns": ["rm *"], "risk": "high", "description": "Remove" } ],
      "strictness_gated": [ { "name": "printf", "patterns": ["printf *"], "description": "Data args" } ],
      "parameter_commands": {
        "git": {
          "modifying_strictness": "normal",
          "global_value_flags": ["-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path"],
          "rules": [
            { "subcommand": ["push"], "decision": "modifying", "risk": "medium" },
            { "subcommand": ["status","log","diff","show","fetch"], "decision": "read-only" }
          ],
          "default": "read-only"
        }
      }
    }
  }
}
