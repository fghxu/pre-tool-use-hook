<?xml version="1.0" encoding="UTF-8"?>
<!--
  strictness_gated suite — NORMAL mode (repo-root config.json, which is all-gated:
  every domain has a gated tier with its risk:low commands).
  Every gated entry must ALLOW; read_only and modifying controls unchanged.
  The ALL-GATED EXTENSION block at the end covers the per-domain gated commands
  (DOS excluded: DOS_CMD gated patterns are only reachable for DOS-routed commands;
  mkdir/move/ren/setx route to the linux fallback domain - pre-existing routing quirk).
-->
<commands>
  <category-group name="SG-Normal">

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git add stages (gated)</description>
      <copilot-command><![CDATA[git add .]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git add -A stages all (gated)</description>
      <copilot-command><![CDATA[git add -A]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git pull (gated)</description>
      <copilot-command><![CDATA[git pull]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git pull --rebase (gated)</description>
      <copilot-command><![CDATA[git pull --rebase]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git commit single -m (gated)</description>
      <copilot-command><![CDATA[git commit -m "test message"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git commit repeated -m for multi-line body (gated)</description>
      <copilot-command><![CDATA[git commit -m "subject" -m "body line"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git switch branch (gated)</description>
      <copilot-command><![CDATA[git switch main]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git init (gated)</description>
      <copilot-command><![CDATA[git init]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git clone (gated)</description>
      <copilot-command><![CDATA[git clone https://github.com/user/repo.git]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git tag -d (gated)</description>
      <copilot-command><![CDATA[git tag -d v1.0]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git tag --delete (gated)</description>
      <copilot-command><![CDATA[git tag --delete v1.0]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git worktree add (gated)</description>
      <copilot-command><![CDATA[git worktree add ../wt feature]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git rev-parse (gated, medium risk shown when it asks in strict)</description>
      <copilot-command><![CDATA[git rev-parse HEAD]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git stash (gated)</description>
      <copilot-command><![CDATA[git stash]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git stash push with message (gated)</description>
      <copilot-command><![CDATA[git stash push -m "wip"]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>printf simple (gated)</description>
      <copilot-command><![CDATA[printf "hello world"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>printf with format string (gated)</description>
      <copilot-command><![CDATA[printf '%s\n' one two]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read_only unaffected" category="SG-Normal-Controls">
      <description>git status stays read_only allow</description>
      <copilot-command><![CDATA[git status]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read_only unaffected" category="SG-Normal-Controls">
      <description>git log stays read_only allow</description>
      <copilot-command><![CDATA[git log --oneline -5]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read_only unaffected" category="SG-Normal-Controls">
      <description>git fetch stays read_only allow</description>
      <copilot-command><![CDATA[git fetch origin]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying unaffected" category="SG-Normal-Controls">
      <description>git push still asks</description>
      <copilot-command><![CDATA[git push origin main]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying unaffected" category="SG-Normal-Controls">
      <description>git reset --hard still asks</description>
      <copilot-command><![CDATA[git reset --hard HEAD]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying unaffected" category="SG-Normal-Controls">
      <description>rm -rf still asks</description>
      <copilot-command><![CDATA[rm -rf /tmp/junk]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal (var-assignment strip)" category="SG-Normal-VarAssignment">
      <description>$x = git add . allows in normal (documents pre-existing #521 behavior)</description>
      <copilot-command><![CDATA[$x = git add .]]></copilot-command>
    </test-case>

    <!-- ALL-GATED EXTENSION: per-domain coverage for the gated risk:low commands -->

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>New-Item (gated)</description>
      <copilot-command><![CDATA[New-Item -Path C:\temp\ni.txt -ItemType File]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>Set-Content (gated)</description>
      <copilot-command><![CDATA[Set-Content -Path C:\temp\sc.txt -Value x]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>Copy-Item (gated)</description>
      <copilot-command><![CDATA[Copy-Item C:\temp\a.txt C:\temp\b.txt]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>Move-Item (gated)</description>
      <copilot-command><![CDATA[Move-Item C:\temp\a.txt C:\temp\c.txt]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>Rename-Item (gated)</description>
      <copilot-command><![CDATA[Rename-Item C:\temp\b.txt b2.txt]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>Add-Content (gated)</description>
      <copilot-command><![CDATA[Add-Content C:\temp\ac.txt x]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-PS-Gated">
      <description>Out-File in pipeline (gated)</description>
      <copilot-command><![CDATA[Get-Process | Out-File C:\temp\of.txt]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>mkdir (gated)</description>
      <copilot-command><![CDATA[mkdir -p /tmp/newdir]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>ln -s (gated)</description>
      <copilot-command><![CDATA[ln -s /opt/a /tmp/b]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>unzip (gated)</description>
      <copilot-command><![CDATA[unzip -o archive.zip -d out]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>adb install (gated)</description>
      <copilot-command><![CDATA[adb install -r app.apk]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Linux-Gated">
      <description>gradlew (gated)</description>
      <copilot-command><![CDATA[gradlew clean]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git worktree remove (gated)</description>
      <copilot-command><![CDATA[git worktree remove ../wt]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git worktree prune (gated)</description>
      <copilot-command><![CDATA[git worktree prune]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git remote add (gated)</description>
      <copilot-command><![CDATA[git remote add origin https://github.com/user/repo.git]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Git-Gated">
      <description>git worktree lock (gated)</description>
      <copilot-command><![CDATA[git worktree lock ../wt]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Terraform-Gated">
      <description>terraform init (gated)</description>
      <copilot-command><![CDATA[terraform init]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Terraform-Gated">
      <description>terraform fmt (gated)</description>
      <copilot-command><![CDATA[terraform fmt -recursive .]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-Terraform-Gated">
      <description>terraform get (gated)</description>
      <copilot-command><![CDATA[terraform get]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: ^terraform providers prefix pattern shadows the gated entry (pre-existing shadowing)" category="SG-Normal-Controls">
      <description>terraform providers mirror (allows via read_only prefix, not gated)</description>
      <copilot-command><![CDATA[terraform providers mirror ./providers]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-K8s-Gated">
      <description>kubectl config use-context (gated)</description>
      <copilot-command><![CDATA[kubectl config use-context minikube]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-K8s-Gated">
      <description>kubectl port-forward (gated)</description>
      <copilot-command><![CDATA[kubectl port-forward pod/web 8080:80]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="gated allow in normal" category="SG-Normal-AWS-Gated">
      <description>aws sso login (gated)</description>
      <copilot-command><![CDATA[aws sso login --profile dev]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="modifying unaffected: Docker gated tier intentionally empty" category="SG-Normal-Docker-Control">
      <description>docker start still asks (Docker has no low-risk entries, gated tier empty)</description>
      <copilot-command><![CDATA[docker start mycontainer]]></copilot-command>
    </test-case>

  </category-group>
</commands>
