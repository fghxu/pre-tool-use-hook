  <category-group name="VarAssignment-Basic-PowerShell">
    <test-case expected="allow" reason="read-only" category="VarAssignment-PS-ReadOnly">
      <description>$var = Get-ChildItem (Get-* read-only verb)</description>
      <copilot-command><![CDATA[$items = Get-ChildItem -Path C:\temp]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-PS-ReadOnly">
      <description>$var = Get-Service (Get-* read-only verb)</description>
      <copilot-command><![CDATA[$svc = Get-Service -Name wuauserv]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-PS-ReadOnly">
      <description>$var = Get-Process (Get-* read-only verb)</description>
      <copilot-command><![CDATA[$procs = Get-Process -Name pwsh]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Stop-Process" category="VarAssignment-PS-Modifying">
      <description>$var = Stop-Process (Stop-* modifying verb)</description>
      <copilot-command><![CDATA[$x = Stop-Process -Name notepad]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Remove-Item" category="VarAssignment-PS-Modifying">
      <description>$var = Remove-Item (Remove-* modifying verb)</description>
      <copilot-command><![CDATA[$x = Remove-Item -Path C:\temp\test.txt]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Set-Service" category="VarAssignment-PS-Modifying">
      <description>$var = Set-Service (Set-* modifying verb)</description>
      <copilot-command><![CDATA[$x = Set-Service -Name wuauserv -StartupType Disabled]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-Comparison-NotStripped">
    <test-case expected="allow" reason="read-only" category="VarAssignment-Comparison">
      <description>if ($x -eq 5) { Get-ChildItem } — -eq is comparison NOT variable assignment, Get-ChildItem is read-only</description>
      <copilot-command><![CDATA[if ($x -eq 5) { Get-ChildItem }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Comparison">
      <description>if ($result -ne $null) { Get-Content file.txt } — -ne is comparison, Get-Content is read-only</description>
      <copilot-command><![CDATA[if ($result -ne $null) { Get-Content file.txt }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Comparison">
      <description>while ($i -lt 10) { $x = Get-ChildItem } — -lt is comparison, Get-ChildItem is read-only</description>
      <copilot-command><![CDATA[while ($i -lt 10) { $x = Get-ChildItem }]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-Chained">
    <test-case expected="allow" reason="read-only" category="VarAssignment-Chained">
      <description>$a = $b = Get-ChildItem (recursive strip, Get-* read-only)</description>
      <copilot-command><![CDATA[$a = $b = Get-ChildItem]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Chained">
      <description>$a = $b = aws sts get-caller-identity (recursive strip, get-* read-only)</description>
      <copilot-command><![CDATA[$a = $b = aws sts get-caller-identity]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Stop-Process" category="VarAssignment-Chained">
      <description>$a = $b = Stop-Process -Name test (recursive strip, Stop-* modifying)</description>
      <copilot-command><![CDATA[$a = $b = Stop-Process -Name test]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-MidSegment">
    <test-case expected="allow" reason="read-only" category="VarAssignment-MidSegment">
      <description>git status; $creds = aws sts get-caller-identity (both read-only after split and strip)</description>
      <copilot-command><![CDATA[git status; $creds = aws sts get-caller-identity]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="VarAssignment-MidSegment">
      <description>git push origin main; $data = aws sts get-caller-identity (git push modifies, aggregate ask)</description>
      <copilot-command><![CDATA[git push origin main; $data = aws sts get-caller-identity]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-MidSegment">
      <description>git status &amp;&amp; $result = aws ec2 describe-instances (both read-only after &amp;&amp; split and strip)</description>
      <copilot-command><![CDATA[git status && $result = aws ec2 describe-instances]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-Pipeline">
    <test-case expected="allow" reason="read-only" category="VarAssignment-Pipeline">
      <description>$result = Get-ChildItem | Get-Member (both Get-* read-only in pipeline)</description>
      <copilot-command><![CDATA[$result = Get-ChildItem | Get-Member]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Remove-Item" category="VarAssignment-Pipeline">
      <description>$result = Get-ChildItem | Remove-Item (Remove-* modifying in pipeline)</description>
      <copilot-command><![CDATA[$result = Get-ChildItem | Remove-Item]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Stop-Process" category="VarAssignment-Pipeline">
      <description>$x = Get-Process | Stop-Process (Stop-* modifying in pipeline)</description>
      <copilot-command><![CDATA[$x = Get-Process | Stop-Process]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-MultiLine">
    <test-case expected="allow" reason="read-only" category="VarAssignment-MultiLine">
      <description>Multi-line: both lines are read-only Get-* cmdlets</description>
      <copilot-command><![CDATA[$x = Get-ChildItem
$y = Get-Process]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Stop-Process" category="VarAssignment-MultiLine">
      <description>Multi-line: first line read-only, second line Stop-Process modifying</description>
      <copilot-command><![CDATA[$x = Get-ChildItem
$y = Stop-Process -Name notepad]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-MultiLine">
      <description>Multi-line: git status and git log (both read-only)</description>
      <copilot-command><![CDATA[$status = git status
$log = git log --oneline -3]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-SSH-Nesting">
    <test-case expected="allow" reason="read-only" category="VarAssignment-SSH">
      <description>ssh user@host with $var = aws sts get-caller-identity inside (read-only)</description>
      <copilot-command><![CDATA[ssh user@host "$creds = aws sts get-caller-identity"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws sts assume-role" category="VarAssignment-SSH">
      <description>ssh user@host with $var = aws sts assume-role inside (modifying)</description>
      <copilot-command><![CDATA[ssh user@host "$creds = aws sts assume-role --role-arn arn:aws:iam::123456789012:role/admin"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-SSH">
      <description>ssh user@host with $var = git status inside (read-only)</description>
      <copilot-command><![CDATA[ssh user@host "$result = git status"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="VarAssignment-SSH">
      <description>ssh user@host with $var = git push inside (modifying)</description>
      <copilot-command><![CDATA[ssh user@host "$result = git push origin main"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-SSH">
      <description>ssh user@host with $var = Get-ChildItem inside pwsh (VerbNoun anchor fix correctly resolves inner Get-ChildItem)</description>
      <copilot-command><![CDATA[ssh user@host "pwsh -Command '$items = Get-ChildItem'"]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-PowerShell-Remoting">
    <test-case expected="allow" reason="read-only" category="VarAssignment-PSRemoting">
      <description>Invoke-Command -ScriptBlock with $var = git status (read-only)</description>
      <copilot-command><![CDATA[Invoke-Command -ScriptBlock { $result = git status }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="VarAssignment-PSRemoting">
      <description>Invoke-Command -ScriptBlock with $var = git push (modifying)</description>
      <copilot-command><![CDATA[Invoke-Command -ScriptBlock { $result = git push origin main }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-PSRemoting">
      <description>pwsh -Command with $var = aws sts get-caller-identity (read-only)</description>
      <copilot-command><![CDATA[pwsh -Command "$creds = aws sts get-caller-identity"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws sts assume-role" category="VarAssignment-PSRemoting">
      <description>pwsh -Command with $var = aws sts assume-role (modifying)</description>
      <copilot-command><![CDATA[pwsh -Command "$creds = aws sts assume-role --role-arn arn:aws:iam::123456789012:role/admin"]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-Nested-PowerShell-SSH">
    <test-case expected="ask" reason="ssh unknown" category="VarAssignment-Nested-PS-SSH">
      <description>pwsh wrapping ssh with aws get-caller-identity (double-nested: intermediate ssh wrapper triggers ask)</description>
      <copilot-command><![CDATA[pwsh -Command "ssh user@host 'aws sts get-caller-identity'"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="VarAssignment-Nested-PS-SSH">
      <description>pwsh wrapping ssh with git push (modifying)</description>
      <copilot-command><![CDATA[pwsh -Command "ssh user@host 'git push origin main'"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="pwsh unknown" category="VarAssignment-Nested-PS-SSH">
      <description>pwsh wrapping ssh wrapping pwsh with $var = Get-ChildItem (triple-nested: intermediate wrappers trigger ask)</description>
      <copilot-command><![CDATA[pwsh -Command "ssh user@host 'pwsh -Command \"`$items = Get-ChildItem\"'"]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-SSH-Nested-BashSubshell">
    <test-case expected="allow" reason="read-only" category="VarAssignment-SSH-BashSubshell">
      <description>ssh user@host with bash creds=$(aws sts get-caller-identity) — subshell read-only</description>
      <copilot-command><![CDATA[ssh user@host "creds=$(aws sts get-caller-identity)"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws sts assume-role" category="VarAssignment-SSH-BashSubshell">
      <description>ssh user@host with bash creds=$(aws sts assume-role ...) — subshell modifying</description>
      <copilot-command><![CDATA[ssh user@host "creds=$(aws sts assume-role --role-arn arn:aws:iam::123456789012:role/admin)"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-SSH-BashSubshell">
      <description>ssh user@host with bash data=$(git status) — subshell read-only</description>
      <copilot-command><![CDATA[ssh user@host "data=$(git status)"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-SSH-BashSubshell">
      <description>ssh user@host with bash pods=$(kubectl get pods) — subshell read-only</description>
      <copilot-command><![CDATA[ssh user@host "pods=$(kubectl get pods)"]]></copilot-command>
    </test-case>
  </category-group>

</commands>
