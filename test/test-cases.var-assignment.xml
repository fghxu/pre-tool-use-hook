<?xml version="1.0" encoding="UTF-8"?>
<commands>

  <category-group name="VarAssignment-Basic-AWS">
    <test-case expected="allow" reason="read-only" category="VarAssignment-AWS-ReadOnly">
      <description>$var = aws sts get-caller-identity (get-* read-only)</description>
      <copilot-command><![CDATA[$creds = aws sts get-caller-identity]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-AWS-ReadOnly">
      <description>$var = aws ec2 describe-instances --region us-east-1 (describe-* read-only, --flags stripped in normal mode)</description>
      <copilot-command><![CDATA[$instances = aws ec2 describe-instances --region us-east-1]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-AWS-ReadOnly">
      <description>$var = aws s3 ls (s3 ls read-only)</description>
      <copilot-command><![CDATA[$buckets = aws s3 ls]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-AWS-ReadOnly">
      <description>$var = aws sts get-caller-identity with --profile global flag (flags stripped in normal mode)</description>
      <copilot-command><![CDATA[$who = aws --profile prod sts get-caller-identity]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws sts assume-role" category="VarAssignment-AWS-Modifying">
      <description>$var = aws sts assume-role (modifying, generates credentials)</description>
      <copilot-command><![CDATA[$creds = aws sts assume-role --role-arn arn:aws:iam::123456789012:role/admin]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws ec2 terminate-instances" category="VarAssignment-AWS-Modifying">
      <description>$var = aws ec2 terminate-instances (modifying, high risk)</description>
      <copilot-command><![CDATA[$x = aws ec2 terminate-instances --instance-ids i-1234567890abcdef0]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws s3 rm" category="VarAssignment-AWS-Modifying">
      <description>$var = aws s3 rm (modifying, high risk)</description>
      <copilot-command><![CDATA[$x = aws s3 rm s3://my-bucket/backup.tar.gz]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="aws s3 sync" category="VarAssignment-AWS-Modifying">
      <description>$var = aws s3 sync with --delete flag (modifying)</description>
      <copilot-command><![CDATA[$x = aws s3 sync ./build s3://my-bucket/ --delete]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-Basic-Git">
    <test-case expected="allow" reason="read-only" category="VarAssignment-Git-ReadOnly">
      <description>$var = git status (read-only)</description>
      <copilot-command><![CDATA[$status = git status]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Git-ReadOnly">
      <description>$var = git log --oneline -5 (read-only)</description>
      <copilot-command><![CDATA[$log = git log --oneline -5]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Git-ReadOnly">
      <description>$var = git -C /opt/repo status (read-only, -C flag stripped)</description>
      <copilot-command><![CDATA[$result = git -C /opt/repo status]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Git-ReadOnly">
      <description>$var = git diff --cached (read-only)</description>
      <copilot-command><![CDATA[$diff = git diff --cached]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="VarAssignment-Git-Modifying">
      <description>$var = git push origin main (modifying)</description>
      <copilot-command><![CDATA[$result = git push origin main]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git add" category="VarAssignment-Git-Modifying">
      <description>$var = git add . (modifying)</description>
      <copilot-command><![CDATA[$x = git add .]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git clean" category="VarAssignment-Git-Modifying">
      <description>$var = git clean -fd (modifying, high risk)</description>
      <copilot-command><![CDATA[$x = git clean -fd]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git reset" category="VarAssignment-Git-Modifying">
      <description>$var = git reset --hard HEAD~1 (modifying, high risk)</description>
      <copilot-command><![CDATA[$x = git reset --hard HEAD~1]]></copilot-command>
    </test-case>
  </category-group>

  <category-group name="VarAssignment-Basic-Docker">
    <test-case expected="allow" reason="read-only" category="VarAssignment-Docker-ReadOnly">
      <description>$var = docker ps (read-only)</description>
      <copilot-command><![CDATA[$containers = docker ps]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="VarAssignment-Docker-ReadOnly">
      <description>$var = docker images (read-only)</description>
