<?xml version="1.0" encoding="UTF-8"?>
<commands>

  <!-- ============================================================
  Windows Full-Path (Local) — 6 cases
  ============================================================ -->
  <category-group name="FullPath-Windows-Local">
    <test-case expected="allow" reason="findstr (read-only)" category="FullPath-Windows-ReadOnly">
      <description>C:\Windows\System32\findstr.exe searches for strings (read-only)</description>
      <copilot-command><![CDATA[C:\Windows\System32\findstr.exe /n "error" *.log]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="tasklist (read-only)" category="FullPath-Windows-ReadOnly">
      <description>C:\Windows\System32\tasklist.exe lists running processes (read-only)</description>
      <copilot-command><![CDATA[C:\Windows\System32\tasklist.exe /v /fo csv]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="netstat (read-only)" category="FullPath-Windows-ReadOnly">
      <description>C:\Windows\System32\netstat.exe shows network connections (read-only)</description>
      <copilot-command><![CDATA[C:\Windows\System32\netstat.exe -ano | findstr ":443"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="taskkill (modifying)" category="FullPath-Windows-Modifying">
      <description>C:\Windows\System32\taskkill.exe kills a process (modifying)</description>
      <copilot-command><![CDATA[C:\Windows\System32\taskkill.exe /f /im notepad.exe]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push (modifying)" category="FullPath-Windows-Modifying">
      <description>Quoted full path "C:\Program Files\Git\bin\git.exe" push origin main (modifying)</description>
      <copilot-command><![CDATA["C:\Program Files\Git\bin\git.exe" push origin main]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="net stop (modifying)" category="FullPath-Windows-Modifying">
      <description>C:\Windows\System32\net.exe stop wuauserv (modifying)</description>
      <copilot-command><![CDATA[C:\Windows\System32\net.exe stop wuauserv]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  Linux Full-Path (Local) — 4 cases
  ============================================================ -->
  <category-group name="FullPath-Linux-Local">
    <test-case expected="allow" reason="grep (read-only)" category="FullPath-Linux-ReadOnly">
      <description>/usr/bin/grep searches for pattern in files (read-only)</description>
      <copilot-command><![CDATA[/usr/bin/grep -r "TODO" /home/user/project/]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="find (read-only)" category="FullPath-Linux-ReadOnly">
      <description>/usr/bin/find searches for files by name (read-only)</description>
      <copilot-command><![CDATA[/usr/bin/find /var/log -name "*.log" -mtime -7]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="rm (modifying, high)" category="FullPath-Linux-Modifying">
      <description>/bin/rm deletes files recursively (modifying, high risk)</description>
      <copilot-command><![CDATA[/bin/rm -rf /tmp/build/]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="systemctl stop (modifying)" category="FullPath-Linux-Modifying">
      <description>/usr/bin/systemctl stop stops a service (modifying)</description>
      <copilot-command><![CDATA[/usr/bin/systemctl stop nginx]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  SSH + Full-Path — 4 cases (2 Windows, 2 Linux)
  ============================================================ -->
  <category-group name="FullPath-SSH">
    <test-case expected="allow" reason="read-only" category="FullPath-SSH-Windows-ReadOnly">
      <description>SSH with Windows full path: ssh user@host "C:\Windows\System32\findstr.exe error *.log" (inner findstr read-only)</description>
      <copilot-command><![CDATA[ssh user@host "C:\Windows\System32\findstr.exe error *.log"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="taskkill" category="FullPath-SSH-Windows-Modifying">
      <description>SSH with Windows full path: ssh user@host "C:\Windows\System32\taskkill.exe /f /im notepad.exe" (inner taskkill modifying)</description>
      <copilot-command><![CDATA[ssh user@host "C:\Windows\System32\taskkill.exe /f /im notepad.exe"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="FullPath-SSH-Linux-ReadOnly">
      <description>SSH with Linux full path: ssh user@host "/usr/bin/grep ERROR /var/log/app.log" (inner grep read-only)</description>
      <copilot-command><![CDATA[ssh user@host "/usr/bin/grep ERROR /var/log/app.log"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="systemctl restart" category="FullPath-SSH-Linux-Modifying">
      <description>SSH with Linux full path: ssh -i key.pem admin@host "/usr/bin/systemctl restart apache2" (inner systemctl modifying)</description>
      <copilot-command><![CDATA[ssh -i key.pem admin@host "/usr/bin/systemctl restart apache2"]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  PowerShell Remoting + Full-Path — 4 cases (2 Windows, 2 Linux)
  ============================================================ -->
  <category-group name="FullPath-PSRemoting">
    <test-case expected="allow" reason="read-only" category="FullPath-PSRemoting-Windows-ReadOnly">
      <description>Invoke-Command with Windows full path: call operator with findstr (inner findstr read-only)</description>
      <copilot-command><![CDATA[Invoke-Command -ScriptBlock { & "C:\Windows\System32\findstr.exe" /n "TODO" *.ps1 }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Remove-Item" category="FullPath-PSRemoting-Windows-Modifying">
      <description>Invoke-Command with Remove-Item (PowerShell cmdlet, modifying)</description>
      <copilot-command><![CDATA[Invoke-Command -ScriptBlock { Remove-Item -Path "C:\temp\test.txt" -Force }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="FullPath-PSRemoting-Linux-ReadOnly">
      <description>pwsh -Command with Linux full path: /usr/bin/grep pattern file (inner grep read-only)</description>
      <copilot-command><![CDATA[pwsh -Command "/usr/bin/grep ERROR /var/log/syslog"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="rm" category="FullPath-PSRemoting-Linux-Modifying">
      <description>pwsh -Command with Linux full path: /bin/rm -rf /tmp/cache (inner rm modifying)</description>
      <copilot-command><![CDATA[pwsh -Command "/bin/rm -rf /tmp/cache"]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  Mixed / Edge Cases — 2 cases
  ============================================================ -->
  <category-group name="FullPath-Mixed">
    <test-case expected="ask" reason="git push + systemctl restart (both modifying)" category="FullPath-Mixed-Chained">
      <description>Chained: full-path git push and full-path systemctl restart (both modifying)</description>
      <copilot-command><![CDATA["C:\Program Files\Git\bin\git.exe" push origin main && /usr/bin/systemctl restart myapp]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="FullPath-Mixed-Pipeline">
      <description>Pipeline: full-path grep piped to sort (both read-only)</description>
      <copilot-command><![CDATA[/usr/bin/grep ERROR /var/log/app.log | /usr/bin/sort -u]]></copilot-command>
    </test-case>
  </category-group>

</commands>
