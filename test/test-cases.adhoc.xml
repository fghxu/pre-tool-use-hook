<?xml version="1.0" encoding="UTF-8"?>
<commands>
  <category-group name="Quick-Smoke">
    <test-case expected="allow" reason="read-only" category="Quick-Smoke">
      <description>Smoke test: dir lists directory contents (read-only)</description>
      <copilot-command><![CDATA[dir C:\temp]]></copilot-command>
    </test-case>
  </category-group>

  <!-- =================================================================== -->
  <!-- Parameter-Value-Aware Classification                                -->
  <!-- TDD RED until parameter_commands is implemented (see spec           -->
  <!-- 2026-07-13-parameter-commands-and-editable-paths-design.md).        -->
  <!-- The point of this group: the deciding parameter (Method, d, X,      -->
  <!-- version) appears at ANY position in the line.                       -->
  <!-- =================================================================== -->

  <category-group name="Parameter-PS-RestMethod">

    <!-- read-only: Get / Head / absent -->
    <test-case expected="allow" reason="read-only: Invoke-RestMethod -Method Get" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod GET (Method at end) — read-only</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Uri "https://example.com" -Method Get]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: Invoke-RestMethod default GET (no -Method)" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod with no -Method defaults to GET — read-only</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Uri "https://example.com"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: Invoke-RestMethod -Method Head" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod HEAD — read-only</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Uri "https://example.com" -Method Head]]></copilot-command>
    </test-case>

    <!-- modifying: Post/Put/Patch/Delete at any position -->
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Post" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod POST (Method first) — modifying</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Method Post -Uri "https://example.com"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Put" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod PUT (Method last) — modifying</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Uri "https://example.com" -Method Put]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Patch" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod PATCH (Method first) — modifying</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Method Patch -Uri "https://example.com"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Delete (high)" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod DELETE (uppercase, reordered) — modifying</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Method DELETE -Uri "https://example.com"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method:Post (colon form)" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod colon-form -Method:Post — modifying</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Method:Post -Uri "https://example.com"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="ask: Invoke-RestMethod -Method Custom (unrecognized value, normal mode)" category="Parameter-PS-RestMethod">
      <description>Invoke-RestMethod with an unrecognized -Method value — ask in strict/normal (forces explicit config)</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Method Custom -Uri "https://example.com"]]></copilot-command>
    </test-case>

    <!-- Invoke-WebRequest + aliases -->
    <test-case expected="allow" reason="read-only: Invoke-WebRequest -Method Get" category="Parameter-PS-RestMethod">
      <description>Invoke-WebRequest GET — read-only</description>
      <copilot-command><![CDATA[Invoke-WebRequest -Uri "https://example.com" -Method Get]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-WebRequest -Method Delete (high)" category="Parameter-PS-RestMethod">
      <description>Invoke-WebRequest DELETE — modifying</description>
      <copilot-command><![CDATA[Invoke-WebRequest -Uri "https://example.com" -Method Delete]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: irm alias -Method Post" category="Parameter-PS-RestMethod">
      <description>irm alias POST — modifying (alias resolved)</description>
      <copilot-command><![CDATA[irm -Uri "https://example.com" -Method Post]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: iwr alias -Method Get (reordered)" category="Parameter-PS-RestMethod">
      <description>iwr alias GET with Method first — read-only (alias + reorder)</description>
      <copilot-command><![CDATA[iwr -Method Get -Uri "https://example.com"]]></copilot-command>
    </test-case>

    <!-- variable assignment wrapping a modifying call -->
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Post (after var-assignment strip)" category="Parameter-PS-RestMethod">
      <description>$response = Invoke-RestMethod ... -Method Post — var stripped, then rule fires</description>
      <copilot-command><![CDATA[$response = Invoke-RestMethod -Uri "https://example.com" -Method Post]]></copilot-command>
    </test-case>

  </category-group>

  <category-group name="Parameter-PS-Embedded">

    <test-case expected="allow" reason="read-only: Invoke-RestMethod -Method Get inside remoting" category="Parameter-PS-Embedded">
      <description>Invoke-Command remoting wrapping a GET — read-only</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName SRV1 -ScriptBlock { Invoke-RestMethod -Uri "https://example.com" -Method Get }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Post inside remoting" category="Parameter-PS-Embedded">
      <description>Invoke-Command remoting wrapping a POST — modifying (inner command classified)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName SRV1 -ScriptBlock { Invoke-RestMethod -Uri "https://example.com" -Method Post }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Delete inside pwsh -Command" category="Parameter-PS-Embedded">
      <description>pwsh -Command wrapping a DELETE — modifying (inner extracted from quoted string)</description>
      <copilot-command><![CDATA[pwsh -Command "Invoke-RestMethod -Method Delete -Uri https://example.com"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: Invoke-RestMethod -Method Post in a chained line" category="Parameter-PS-Embedded">
      <description>Chained: POST call ; Get-Process — modifying sub-command wins</description>
      <copilot-command><![CDATA[$r = Invoke-RestMethod -Method Post -Uri https://example.com; Get-Process]]></copilot-command>
    </test-case>

  </category-group>

  <category-group name="Parameter-Linux-Curl">

    <!-- modifying: -d (short) and long data flag at any position -->
    <test-case expected="ask" reason="modifying: curl -d (data before URL)" category="Parameter-Linux-Curl">
      <description>curl POST via -d before the URL — modifying</description>
      <copilot-command><![CDATA[curl -H "Content-Type: application/json" -d '{"name":"John","age":30}' https://example.com]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: curl -d (data after URL)" category="Parameter-Linux-Curl">
      <description>curl POST via -d AFTER the URL — modifying (position-independent)</description>
      <copilot-command><![CDATA[curl https://example.com -H "Content-Type: application/json" -d '{"name":"John","age":30}']]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: curl --data" category="Parameter-Linux-Curl">
      <description>curl POST via long --data flag — modifying</description>
      <copilot-command><![CDATA[curl --data '{"a":1}' https://example.com]]></copilot-command>
    </test-case>

    <!-- modifying: -X verb (space and attached forms) -->
    <test-case expected="ask" reason="modifying: curl -X POST" category="Parameter-Linux-Curl">
      <description>curl explicit POST — modifying</description>
      <copilot-command><![CDATA[curl -X POST https://example.com]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: curl -X PUT" category="Parameter-Linux-Curl">
      <description>curl explicit PUT — modifying</description>
      <copilot-command><![CDATA[curl -X PUT https://example.com]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: curl -X DELETE" category="Parameter-Linux-Curl">
      <description>curl explicit DELETE (spaced) — modifying</description>
      <copilot-command><![CDATA[curl -X DELETE https://example.com]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: curl -XDELETE (attached)" category="Parameter-Linux-Curl">
      <description>curl DELETE attached (-XDELETE, no space) — modifying (currently mis-classified as allow; this is the bug being fixed)</description>
      <copilot-command><![CDATA[curl -XDELETE https://example.com]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="ask: curl -X FROG (unrecognized verb, normal mode)" category="Parameter-Linux-Curl">
      <description>curl with an unrecognized -X verb — ask in strict/normal (currently mis-allowed; another position/value bug being fixed)</description>
      <copilot-command><![CDATA[curl -X FROG https://example.com]]></copilot-command>
    </test-case>

    <!-- modifying: upload flags -->
    <test-case expected="ask" reason="modifying: curl -F (form upload)" category="Parameter-Linux-Curl">
      <description>curl multipart form upload (-F) — modifying</description>
      <copilot-command><![CDATA[curl -F 'file=@report.txt' https://example.com/upload]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: curl -T (file upload)" category="Parameter-Linux-Curl">
      <description>curl file upload (-T) — modifying</description>
      <copilot-command><![CDATA[curl -T archive.zip https://example.com/upload]]></copilot-command>
    </test-case>

    <!-- read-only: plain GET -->
    <test-case expected="allow" reason="read-only: curl -X GET" category="Parameter-Linux-Curl">
      <description>curl explicit GET — read-only</description>
      <copilot-command><![CDATA[curl -X GET https://example.com]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: curl silent GET" category="Parameter-Linux-Curl">
      <description>curl silent GET — read-only (no modifying flag)</description>
      <copilot-command><![CDATA[curl -s https://httpbin.org/ip]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: curl plain GET" category="Parameter-Linux-Curl">
      <description>curl plain GET — read-only</description>
      <copilot-command><![CDATA[curl https://example.com]]></copilot-command>
    </test-case>

  </category-group>

  <category-group name="Parameter-Linux-Python">

    <test-case expected="allow" reason="read-only: python --version" category="Parameter-Linux-Python">
      <description>python --version with stderr redirect — read-only</description>
      <copilot-command><![CDATA[python --version 2>&1]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: python -V" category="Parameter-Linux-Python">
      <description>python -V short flag — read-only</description>
      <copilot-command><![CDATA[python -V]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: python --help" category="Parameter-Linux-Python">
      <description>python --help — read-only</description>
      <copilot-command><![CDATA[python --help]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only: python3 --version (alias)" category="Parameter-Linux-Python">
      <description>python3 alias --version — read-only</description>
      <copilot-command><![CDATA[python3 --version]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="modifying: python runs a script (default)" category="Parameter-Linux-Python">
      <description>python runs a script — modifying (no read-only flag, default modifying)</description>
      <copilot-command><![CDATA[python gen_t4.py]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: python3 runs a script with args (alias)" category="Parameter-Linux-Python">
      <description>python3 runs a training script with args — modifying</description>
      <copilot-command><![CDATA[python3 train.py --epochs 10]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="modifying: py alias runs a script" category="Parameter-Linux-Python">
      <description>py alias runs a script — modifying</description>
      <copilot-command><![CDATA[py script.py]]></copilot-command>
    </test-case>

  </category-group>

  <category-group name="New-Samples-Regex-Confusion">

    <test-case expected="ask" reason="git tag" category="DOS-Git-Modifying">
      <description>git tag with multi-line message + git log + git tag list pipeline</description>
      <copilot-command><![CDATA[git tag -a v3.2.0-observability -m "V3 and graceful shutdown

Added
see commit"; git log --oneline -3; git tag -l | Sort-Object -Descending | Select-Object -First 3]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PowerShell-ReadOnly">
      <description>Select-String path+pattern with pipes and brackets in regex, piped to ForEach/Where</description>
      <copilot-command><![CDATA[Select-String -Path "$env:temp\build.log" -Pattern "server.*not ready|server is healthy" | ForEach-Object { $_.Line } | Where-Object { $_ -match "step|18:" -or $_ -notmatch "^\[" }]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PowerShell-ReadOnly">
      <description>Select-String simple regex with anchors and pipes</description>
      <copilot-command><![CDATA[Select-String -Pattern '^## | ^### ']]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PowerShell-ReadOnly">
      <description>Variable assignment using -replace with regex string containing pipes/parens and scriptblock</description>
      <copilot-command><![CDATA[$line = $line -replace 'deploy BC|Deploy BC|Summary \(BC\)', { $_.Value -replace 'BC', 'PC' -replace 'bc', 'pc' }]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PowerShell-ReadOnly">
      <description>Call operator &amp; with scriptblock containing Get-Content and ConvertFrom-Json</description>
      <copilot-command><![CDATA[& { $json = Get-Content -Path 'jenkins\build.json' -Raw; $buildinfo = $json | ConvertFrom-Json; }]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="AWS-Normal-ReadOnly">
      <description>AWS configure get is a read-only lookup</description>
      <copilot-command><![CDATA[aws configure get sso_role_name]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PowerShell-ReadOnly">
      <description>.NET file read + substring with Math::Max expression</description>
      <copilot-command><![CDATA[$raw = [System.IO.File]::ReadAllText("c:\a.txt"); $tail = $raw.Substring([Math]::Max(0, $raw.Length));]]></copilot-command>
    </test-case>

  </category-group>

  <category-group name="PS-Safe-Expressions">

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>Hashtable assignment with variable value</description>
      <copilot-command><![CDATA[$headers = @{'provate-token' = $gittoken}]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>String split piped to Select-Object</description>
      <copilot-command><![CDATA[$log -split "`n" | Select-Object -First 40]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>Invoke-RestMethod GET followed by regex filter pipeline with pipes in pattern</description>
      <copilot-command><![CDATA[Invoke-RestMethod -Method Get -Headers $hdr -Uri 'https://server/text'; ($b801log -split "`n" | Select-String -Pattern 'Error:|Exception out|failure|pass:' | Select-Object -First 20)]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>SSH with key variable and read-only remote commands</description>
      <copilot-command><![CDATA[$key='c:\temp\a path\a.pem'; ssh -i $key -o StrictHostKeyChecking=accept-new -o BatchMode=yes user@server 'whoami;hostname']]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>AWS version and Get-Content in same line</description>
      <copilot-command><![CDATA[aws --version; Get-Content $file]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>Bare hashtable expression</description>
      <copilot-command><![CDATA[@{ authorization  = "Basice $encodeed" }]]></copilot-command>
    </test-case>

    <test-case expected="allow" reason="read-only" category="PS-Safe-Expressions">
      <description>JSON string assignment (inner JSON is string data)</description>
      <copilot-command><![CDATA[$body = '{"id": "1", "name": "2" "context":{"id": "1"} }']]></copilot-command>
    </test-case>

  </category-group>

  <category-group name="AST-Arbiter-Guard">

    <test-case expected="ask" reason="git" category="AST-Arbiter-Guard">
      <description>Unknown git subcommand stays ask (arbiter inconclusive)</description>
      <copilot-command><![CDATA[git --online -3]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="unknown command" category="AST-Arbiter-Guard">
      <description>Unknown cmdlet stays ask</description>
      <copilot-command><![CDATA[Some-UnknownCmdlet -Foo]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="unknown command" category="AST-Arbiter-Guard">
      <description>One unknown element poisons a pipeline</description>
      <copilot-command><![CDATA[weirdcmd -x | Get-Process]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="Invoke-Expression" category="AST-Arbiter-Guard">
      <description>Command inside an assignment is never a safe expression</description>
      <copilot-command><![CDATA[$x = Invoke-Expression 'evil']]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="unknown command" category="AST-Arbiter-Guard">
      <description>Bash for-loop with unknown command: PS parse error, arbiter aborts</description>
      <copilot-command><![CDATA[for f in /etc/*; do weirdcmd $f; done]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="unknown command" category="AST-Arbiter-Guard">
      <description>.NET Delete is not in the method allowlist</description>
      <copilot-command><![CDATA[$x = [System.IO.File]::Delete('c:\temp\x.txt')]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="unknown command" category="AST-Arbiter-Guard">
      <description>Instance method Kill is not in the method allowlist</description>
      <copilot-command><![CDATA[$proc.Kill()]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="unknown command" category="AST-Arbiter-Guard">
      <description>Property SET on a type is a side effect</description>
      <copilot-command><![CDATA[[Console]::Title = 'x']]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="redirection-target" category="AST-Arbiter-Guard">
      <description>Redirect outside CWD/editable blocks; redirect blockers bypass the arbiter</description>
      <copilot-command><![CDATA[echo hi > ..\outside\file.txt]]></copilot-command>
    </test-case>

    <test-case expected="ask" reason="rm" category="AST-Arbiter-Guard">
      <description>Known-modifying inner command: arbiter never runs</description>
      <copilot-command><![CDATA[ssh user@host 'rm -rf /tmp/x']]></copilot-command>
    </test-case>

  </category-group>

</commands>
