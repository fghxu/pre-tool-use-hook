<?xml version="1.0" encoding="UTF-8"?>
<commands>

  <!-- ============================================================
  SSH + Full-Path Executables — 6 cases
  Full-path commands wrapped in SSH, quoted and unquoted,
  Windows and Linux targets.
  ============================================================ -->
  <category-group name="SSH-FullPath">
    <test-case expected="allow" reason="grep (read-only)" category="SSH-FullPath-Linux-ReadOnly">
      <description>SSH with Linux full path /usr/bin/grep (inner read-only after path strip)</description>
      <copilot-command><![CDATA[ssh user@host "/usr/bin/grep ERROR /var/log/app.log"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="rm (modifying, high)" category="SSH-FullPath-Linux-Modifying">
      <description>SSH with Linux full path /bin/rm (inner modifying after path strip)</description>
      <copilot-command><![CDATA[ssh user@host "/bin/rm -rf /tmp/cache/"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="systemctl restart (modifying)" category="SSH-FullPath-Linux-Systemctl">
      <description>SSH with Linux full path /usr/bin/systemctl restart (inner modifying after path strip)</description>
      <copilot-command><![CDATA[ssh -i key.pem admin@host "/usr/bin/systemctl restart apache2"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="findstr (read-only)" category="SSH-FullPath-Windows-ReadOnly">
      <description>SSH with Windows full path C:\Windows\System32\findstr.exe (inner read-only after path strip)</description>
      <copilot-command><![CDATA[ssh user@host "C:\Windows\System32\findstr.exe /n error *.log"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="taskkill (modifying)" category="SSH-FullPath-Windows-Modifying">
      <description>SSH with quoted Windows full path "C:\Program Files\tool.exe" (inner unknown after path strip, ask)</description>
      <copilot-command><![CDATA[ssh user@host "\"C:\Program Files\MyApp\tool.exe\" /status"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="SSH-FullPath-Sudo-Git">
      <description>SSH with sudo and full path /usr/bin/git status (sudo stripped, git status read-only after path strip)</description>
      <copilot-command><![CDATA[ssh user@host "sudo /usr/bin/git -C /opt/repo status"]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  DOS + Full-Path Executables — 6 cases
  Full-path commands including git, aws, kubectl, and native
  Windows tools, quoted and unquoted paths.
  ============================================================ -->
  <category-group name="DOS-FullPath">
    <test-case expected="allow" reason="git status (read-only)" category="DOS-FullPath-Git-ReadOnly">
      <description>Quoted full path "C:\Program Files\Git\bin\git.exe" status (git status read-only after path strip)</description>
      <copilot-command><![CDATA["C:\Program Files\Git\bin\git.exe" status]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push (modifying)" category="DOS-FullPath-Git-Modifying">
      <description>Quoted full path "C:\Program Files\Git\bin\git.exe" push origin main (git push modifying after path strip)</description>
      <copilot-command><![CDATA["C:\Program Files\Git\bin\git.exe" push origin main]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="taskkill (modifying)" category="DOS-FullPath-Windows-Modifying">
      <description>Unquoted full path C:\Windows\System32\taskkill.exe (taskkill modifying after path strip)</description>
      <copilot-command><![CDATA[C:\Windows\System32\taskkill.exe /f /im notepad.exe]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="netstat (read-only)" category="DOS-FullPath-Windows-ReadOnly">
      <description>Unquoted full path C:\Windows\System32\netstat.exe (netstat read-only after path strip)</description>
      <copilot-command><![CDATA[C:\Windows\System32\netstat.exe -ano]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="aws describe-* (read-only)" category="DOS-FullPath-AWS-ReadOnly">
      <description>Quoted full path "C:\Program Files\Amazon\AWSCLI\bin\aws.exe" ec2 describe-instances (aws describe read-only after path strip)</description>
      <copilot-command><![CDATA["C:\Program Files\Amazon\AWSCLI\bin\aws.exe" ec2 describe-instances --region us-east-1]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="kubectl delete (modifying)" category="DOS-FullPath-Kubectl-Modifying">
      <description>Unquoted full path D:\tools\kubectl.exe delete pod (kubectl delete modifying after path strip)</description>
      <copilot-command><![CDATA[D:\tools\kubectl.exe delete pod my-pod -n default]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  PowerShell Remoting + Full-Path — 8 cases
  Tests full-path executables invoked inside Invoke-Command,
  pwsh -Command, and Enter-PSSession wrappers.
  ============================================================ -->
  <category-group name="PSRemoting-FullPath">
    <test-case expected="allow" reason="findstr (read-only)" category="PSRemoting-FullPath-Windows-ReadOnly">
      <description>Invoke-Command with full-path findstr.exe (inner read-only after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { & "C:\Windows\System32\findstr.exe" /n "error" *.log }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="taskkill (modifying)" category="PSRemoting-FullPath-Windows-Modifying">
      <description>Invoke-Command with full-path taskkill.exe (inner modifying after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { & "C:\Windows\System32\taskkill.exe" /f /im notepad.exe }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="unknown command" category="PSRemoting-FullPath-Windows-Unknown">
      <description>Invoke-Command with full-path custom exe "C:\test program\delete.exe" (unknown command after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { & "C:\test program\delete.exe" /force /quiet }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="findstr (read-only)" category="PSRemoting-FullPath-Unquoted">
      <description>Invoke-Command with unquoted full path C:\Windows\System32\findstr.exe (inner read-only after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { C:\Windows\System32\findstr.exe /n "TODO" *.ps1 }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="grep (read-only)" category="PSRemoting-FullPath-Linux-ReadOnly">
      <description>pwsh -Command with Linux full path /usr/bin/grep (inner read-only after path strip)</description>
      <copilot-command><![CDATA[pwsh -Command "/usr/bin/grep ERROR /var/log/syslog"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="rm (modifying)" category="PSRemoting-FullPath-Linux-Modifying">
      <description>pwsh -Command with Linux full path /bin/rm (inner modifying after path strip)</description>
      <copilot-command><![CDATA[pwsh -Command "/bin/rm -rf /tmp/cache/"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="systemctl stop (modifying)" category="PSRemoting-FullPath-SSH-Systemctl">
      <description>ssh to pwsh wrapping full-path systemctl stop (double-nested, inner modifying)</description>
      <copilot-command><![CDATA[ssh user@host "pwsh -Command '/usr/bin/systemctl stop nginx'"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="PSRemoting-FullPath-Mixed-Pipeline">
      <description>Invoke-Command with piped full-path commands: findstr piped to sort (all read-only after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { C:\Windows\System32\findstr.exe /n "ERROR" *.log | C:\Windows\System32\sort.exe }]]></copilot-command>
    </test-case>
  </category-group>

</commands>
