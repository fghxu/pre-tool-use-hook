<?xml version="1.0" encoding="UTF-8"?>
<commands>

  <!-- ============================================================
  Linux SSH + Git — 6 cases
  ============================================================ -->
  <category-group name="Linux-SSH-Git">
    <test-case expected="allow" reason="read-only" category="Linux-SSH-Git-ReadOnly">
      <description>SSH remote git status (read-only)</description>
      <copilot-command><![CDATA[ssh user@host "git status"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="Linux-SSH-Git-ReadOnly">
      <description>SSH remote git -C /path status (read-only, -C flag stripped)</description>
      <copilot-command><![CDATA[ssh user@host "git -C /opt/repo status"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="Linux-SSH-Git-ReadOnly">
      <description>SSH remote sudo git -C /path log --oneline (sudo stripped, git log read-only)</description>
      <copilot-command><![CDATA[ssh user@host "sudo git -C /opt/che/cookbook log --oneline"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="Linux-SSH-Git-Modifying">
      <description>SSH remote git -C /path push origin main (modifying)</description>
      <copilot-command><![CDATA[ssh user@host "git -C /opt/repo push origin main"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="sudo git push" category="Linux-SSH-Git-Modifying">
      <description>SSH remote sudo git -C /path push (sudo stripped, git push modifying)</description>
      <copilot-command><![CDATA[ssh admin@prod "sudo git -C /opt/site push origin master"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="unknown command" category="Linux-SSH-Git-Unknown">
      <description>SSH remote sudo git -C /path --online -3 2>/dev/null (unknown git subcommand)</description>
      <copilot-command><![CDATA[ssh user@host "sudo git -C /opt/che/cookbook --online -3 2>/dev/null"]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  DOS Git — 6 cases
  ============================================================ -->
  <category-group name="DOS-Git">
    <test-case expected="allow" reason="read-only" category="DOS-Git-ReadOnly">
      <description>git -C C:\repo status (read-only, -C flag stripped)</description>
      <copilot-command><![CDATA[git -C C:\repo status]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="DOS-Git-ReadOnly">
      <description>git -C "C:\Program Files\repo" log --oneline (read-only, quoted path, -C stripped)</description>
      <copilot-command><![CDATA[git -C "C:\Program Files\repo" log --oneline]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="DOS-Git-ReadOnly">
      <description>git -c core.autocrlf=true -C C:\repo diff (read-only, multiple flags stripped)</description>
      <copilot-command><![CDATA[git -c core.autocrlf=true -C C:\repo diff]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="DOS-Git-Modifying">
      <description>git -C C:\repo push origin main (modifying, -C flag stripped)</description>
      <copilot-command><![CDATA[git -C C:\repo push origin main]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git reset" category="DOS-Git-Modifying">
      <description>git -C C:\repo reset --hard HEAD~1 (modifying, high risk)</description>
      <copilot-command><![CDATA[git -C C:\repo reset --hard HEAD~1]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="unknown command" category="DOS-Git-Unknown">
      <description>git -C C:\repo --online -3 (unknown git subcommand)</description>
      <copilot-command><![CDATA[git -C C:\repo --online -3]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  PowerShell Remoting — 8 cases
  ============================================================ -->
  <category-group name="PowerShell-Remoting">
    <test-case expected="allow" reason="Get-Process (Get-* read-only verb)" category="PSRemoting-ReadOnly">
      <description>Invoke-Command -ComputerName with Get-Process (read-only)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Get-Process -Name pwsh }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="Get-Service (Get-* read-only verb)" category="PSRemoting-ReadOnly">
      <description>Invoke-Command -Session with Get-Service (read-only)</description>
      <copilot-command><![CDATA[Invoke-Command -Session $session -ScriptBlock { Get-Service -Name wuauserv }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="Get-ChildItem (Get-* read-only verb)" category="PSRemoting-ReadOnly">
      <description>Invoke-Command with Get-ChildItem recursively listing files (read-only)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Get-ChildItem -Path C:\logs -Recurse -ErrorAction SilentlyContinue }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="Get-EventLog (Get-* read-only verb)" category="PSRemoting-ReadOnly">
      <description>Invoke-Command with Get-EventLog (read-only)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Get-EventLog -LogName Application -Newest 50 }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Stop-Process (Stop-* modifying verb)" category="PSRemoting-Modifying">
      <description>Invoke-Command with Stop-Process (modifying, Stop-* verb)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Stop-Process -Name notepad -Force }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Remove-Item (Remove-* modifying verb)" category="PSRemoting-Modifying">
      <description>Invoke-Command with Remove-Item (modifying, Remove-* verb)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Remove-Item -Path C:\temp\*.log -Force }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Set-Service (Set-* modifying verb)" category="PSRemoting-Modifying">
      <description>Invoke-Command with Set-Service (modifying, Set-* verb)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Set-Service -Name wuauserv -StartupType Disabled }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="Restart-Service (Restart-* modifying verb)" category="PSRemoting-Modifying">
      <description>Invoke-Command with Restart-Service (modifying, Restart-* high risk verb)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { Restart-Service -Name spooler }]]></copilot-command>
    </test-case>
  </category-group>

</commands>
