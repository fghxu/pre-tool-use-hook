<?xml version="1.0" encoding="UTF-8"?>
<commands>

  <!-- ============================================================
  Linux SSH + Git — 6 cases
  ============================================================ -->
  <category-group name="Linux-SSH-Git">
    <test-case expected="allow" reason="read-only" category="Linux-SSH-Git-ReadOnly">
      <description>SSH remote git status (read-only)</description>
      <copilot-command><![CDATA[ssh user@host "git status"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="Linux-SSH-Git-ReadOnly">
      <description>SSH remote git -C /path status (read-only, -C flag stripped)</description>
      <copilot-command><![CDATA[ssh user@host "git -C /opt/repo status"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="Linux-SSH-Git-ReadOnly">
      <description>SSH remote sudo git -C /path log --oneline (sudo stripped, git log read-only)</description>
      <copilot-command><![CDATA[ssh user@host "sudo git -C /opt/che/cookbook log --oneline"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="Linux-SSH-Git-Modifying">
      <description>SSH remote git -C /path push origin main (modifying)</description>
      <copilot-command><![CDATA[ssh user@host "git -C /opt/repo push origin main"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="sudo git push" category="Linux-SSH-Git-Modifying">
      <description>SSH remote sudo git -C /path push (sudo stripped, git push modifying)</description>
      <copilot-command><![CDATA[ssh admin@prod "sudo git -C /opt/site push origin master"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="unknown command" category="Linux-SSH-Git-Unknown">
      <description>SSH remote sudo git -C /path --online -3 2>/dev/null (unknown git subcommand)</description>
      <copilot-command><![CDATA[ssh user@host "sudo git -C /opt/che/cookbook --online -3 2>/dev/null"]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  DOS Git — 6 cases
  ============================================================ -->
  <category-group name="DOS-Git">
    <test-case expected="allow" reason="read-only" category="DOS-Git-ReadOnly">
      <description>git -C C:\repo status (read-only, -C flag stripped)</description>
      <copilot-command><![CDATA[git -C C:\repo status]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="DOS-Git-ReadOnly">
      <description>git -C "C:\Program Files\repo" log --oneline (read-only, quoted path, -C stripped)</description>
      <copilot-command><![CDATA[git -C "C:\Program Files\repo" log --oneline]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="DOS-Git-ReadOnly">
      <description>git -c core.autocrlf=true -C C:\repo diff (read-only, multiple flags stripped)</description>
      <copilot-command><![CDATA[git -c core.autocrlf=true -C C:\repo diff]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git push" category="DOS-Git-Modifying">
      <description>git -C C:\repo push origin main (modifying, -C flag stripped)</description>
      <copilot-command><![CDATA[git -C C:\repo push origin main]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="git reset" category="DOS-Git-Modifying">
      <description>git -C C:\repo reset --hard HEAD~1 (modifying, high risk)</description>
      <copilot-command><![CDATA[git -C C:\repo reset --hard HEAD~1]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="unknown command" category="DOS-Git-Unknown">
      <description>git -C C:\repo --online -3 (unknown git subcommand)</description>
      <copilot-command><![CDATA[git -C C:\repo --online -3]]></copilot-command>
    </test-case>
  </category-group>

  <!-- ============================================================
  PowerShell Remoting + Full-Path — 8 cases
  Tests full-path executables invoked inside Invoke-Command,
  pwsh -Command, and Enter-PSSession wrappers.
  ============================================================ -->
  <category-group name="PSRemoting-FullPath">
    <test-case expected="allow" reason="findstr (read-only)" category="PSRemoting-FullPath-Windows-ReadOnly">
      <description>Invoke-Command with full-path findstr.exe (inner read-only after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { & "C:\Windows\System32\findstr.exe" /n "error" *.log }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="taskkill (modifying)" category="PSRemoting-FullPath-Windows-Modifying">
      <description>Invoke-Command with full-path taskkill.exe (inner modifying after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { & "C:\Windows\System32\taskkill.exe" /f /im notepad.exe }]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="unknown command" category="PSRemoting-FullPath-Windows-Unknown">
      <description>Invoke-Command with full-path custom exe "C:\test program\delete.exe" (unknown command after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { & "C:\test program\delete.exe" /force /quiet }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="findstr (read-only)" category="PSRemoting-FullPath-Unquoted">
      <description>Invoke-Command with unquoted full path C:\Windows\System32\findstr.exe (inner read-only after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { C:\Windows\System32\findstr.exe /n "TODO" *.ps1 }]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="grep (read-only)" category="PSRemoting-FullPath-Linux-ReadOnly">
      <description>pwsh -Command with Linux full path /usr/bin/grep (inner read-only after path strip)</description>
      <copilot-command><![CDATA[pwsh -Command "/usr/bin/grep ERROR /var/log/syslog"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="rm (modifying)" category="PSRemoting-FullPath-Linux-Modifying">
      <description>pwsh -Command with Linux full path /bin/rm (inner modifying after path strip)</description>
      <copilot-command><![CDATA[pwsh -Command "/bin/rm -rf /tmp/cache/"]]></copilot-command>
    </test-case>
    <test-case expected="ask" reason="systemctl stop (modifying)" category="PSRemoting-FullPath-SSH-Systemctl">
      <description>ssh to pwsh wrapping full-path systemctl stop (double-nested, inner modifying)</description>
      <copilot-command><![CDATA[ssh user@host "pwsh -Command '/usr/bin/systemctl stop nginx'"]]></copilot-command>
    </test-case>
    <test-case expected="allow" reason="read-only" category="PSRemoting-FullPath-Mixed-Pipeline">
      <description>Invoke-Command with piped full-path commands: findstr piped to sort (all read-only after path strip)</description>
      <copilot-command><![CDATA[Invoke-Command -ComputerName server01 -ScriptBlock { C:\Windows\System32\findstr.exe /n "ERROR" *.log | C:\Windows\System32\sort.exe }]]></copilot-command>
    </test-case>
  </category-group>

</commands>
